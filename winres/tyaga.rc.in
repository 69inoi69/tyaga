// Windows resources: the icon and what "Properties → Details" shows.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     @MAJOR@,@MINOR@,@PATCH@,0
PRODUCTVERSION  @MAJOR@,@MINOR@,@PATCH@,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "TYAGA"
      VALUE "FileDescription",  "TYAGA - YouTube video and audio downloader"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "tyaga"
      VALUE "LegalCopyright",   "Oleksandr Lysiuk, MIT License"
      VALUE "OriginalFilename", "tyaga.exe"
      VALUE "ProductName",      "TYAGA"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
